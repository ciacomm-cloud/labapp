[Unit]
Description=labapp - Sistema de Inventario Micropropagacion (FastAPI backend)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/castamay-labapp/labapp/backend
ExecStart=/home/castamay-labapp/labapp/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8766 --workers 2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
